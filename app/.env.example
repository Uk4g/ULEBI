# ───────────── ULEBI server environment (server-only; never prefix with NEXT_PUBLIC_) ─────────────

# ── Self-hosted configuration ──
# Generate a secret: openssl rand -hex 32
PAYLOAD_SECRET=
# Local SQLite file. One Node server = whole backend. No external DB account.
DATABASE_URL=file:./wardni.db
# Public URL of this deployment, used for metadata/links only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=3000

# One Meta Model API key covers all four models (https://dev.meta.ai). Set per-model keys only if you need to split billing.
MODEL_API_KEY=
# SPARK_API_KEY=   SAM_API_KEY=   WONDER_API_KEY=   VOICE_API_KEY=

# Model IDs (defaults shown). IDs ending in "-contributor" are REFUSED: Contributor mode lets Meta train on your
# prompts, and ULEBI sends patient audio, video, notes and transcripts.
# SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1
# WONDER_MODEL=muse-wonder-1.0
# VOICE_MODEL=muse-voice-transcribe-1.0
# META_BASE_URL=https://api.meta.ai/v1

# Muse Wonder (movement assessment from the 3.5 s clip).
#   gated  (default) only when rules/SAM say something is worth a second look
#   always           every rolling slice (rate-limited per room)
#   off              Spark-on-telemetry only
# WONDER_MODE=gated
# WONDER_MIN_INTERVAL_SEC=15

# Muse Voice Transcribe: set VOICE_MODE=off to force the browser's built-in speech recognition instead.
# VOICE_MODE=on

# Restrict who can sign in by email domain. Default: ulebi.com (@ulebi.com accounts only).
ULEBI_ALLOWED_EMAIL_DOMAINS=ulebi.com

# Allow any @ulebi.com email + password (8+ chars) to sign in directly to the dashboard.
ULEBI_TEST_LOGIN=true

# Allow camera URLs on private/LAN addresses (needed for most hospital IP cameras).
# ALLOW_LOCAL_CAM=true
